@article{rigaut_mavis_2021,
	title = {{MAVIS} on the {VLT}: {A} {Powerful}, {Synergistic} {ELT} {Complement} in the {Visible}},
	volume = {pp. 7-11},
	copyright = {Copyright European Southern Observatory},
	issn = {0722-6691},
	shorttitle = {{MAVIS} on the {VLT}},
	url = {http://doi.eso.org/10.18727/0722-6691/5245},
	doi = {10.18727/0722-6691/5245},
	abstract = {On 1 June 2021 ESO and a consortium of Australian, Italian and French institutions signed an agreement for the design and construction of the MCAO Assisted Visible Imager and Spectrograph (MAVIS). This Very Large Telescope (VLT) instrument will push the frontier of new astronomical instrument technologies to provide, for the first time, wide-field, diffraction-limited angular resolution at visible wavelengths. In combination with the VLT Adaptive Optics Facility, it will use multi- conjugate adaptive optics (MCAO) to feed a 4k × 4k imager covering 30 × 30 arcseconds, as well as an Integral Field Spectrograph (IFS). Angular resolution down to 18 milliarcseconds will be achieved at a wavelength of 550 nm (\textit{V} band). The IFS will provide four spectral modes, with spectral resolutions from 4000 to over 15000 between 370 and 950 nm. This will enable a wide variety of science cases, spanning themes that include the emergence of the Hubble sequence, resolving the contents of nearby galaxies, star clusters over cosmic time and the birth, life, and death of stars and their planets. Delivering visible images and integral- field spectroscopy at an angular resolution two to three times better than that of the Hubble Space Telescope will make MAVIS a powerful complement at visible wavelengths to future facilities like the James Webb Space Telescope and the 30–40-metre-class ground-based telescopes currently under construction, which are all optimised for science at infrared wavelengths.},
	journal = {Published in The Messenger vol. 185},
	publisher = {European Southern Observatory (ESO)},
	author = {Rigaut, François and McDermid, Richard and Cresci, Giovanni and Agapito, Guido and Aliverti, Matteo and Antoniucci, Simone and Balestra, Andrea and Baruffolo, Andrea and Beltramo-Martin, Olivier and Bergomi, Maria and Bianco, Andrea and Bonaglia, Marco and Bono, Giuseppe and Bouret, Jean-Claude and Brodrick, David and Busoni, Lorenzo and Capasso, Giulio and Carolo, Elena and Chinellato, Simonetta and Colapietro, Mirko and Content, Robert and Cranney, Jesse and De Silva, Gayandhi and D’Orsi, Sergio and Ellis, Simon and Fantinel, Daniela and Fusco, Thierry and Galla, Antony and Gausachs, Gaston and Gratadour, Damien and Greggio, Davide and Gullieuszik, Marco and Haguenauer, Pierre and Haynes, Dionne and Herrald, Nick and Horton, Anthony and Kamath, Devika and Magrini, Laura and Marasco, Antonino and Marafatto, Luca and Massari, Davide and McGregor, Helen and Mendel, Trevor and Monty, Stephanie and Neichel, Benoit and Pinna, Enrico and Plantet, Cédric and Portaluri, Elisa and Robertson, David and Salasnich, Bernardo and Savarese, Salvatore and Schipani, Pietro and Schwab, Christian and Smedley, Scott and Sordo, Rosanna and Ströbele, Stefan and Vaccarella, Annino and Vassallo, Daniele and Viotto, Valentina and Waller, Lew and Zanutta, Alessio and Zhang, Hao and Seemann, Ulf and Kuntschner, Harald and Arsenault, Robin},
