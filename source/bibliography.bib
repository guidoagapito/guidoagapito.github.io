@inproceedings{busoni_adaptive_2019,
	title = {Adaptive optics design status of {MAORY}, the {MCAO} system of {European} {ELT}},
	url = {https://ao4elt6.copl.ulaval.ca/proceedings/401-i93M-271.pdf},
	abstract = {MAORY is the Multi-conjugate Adaptive Optics RelaY for the European ELT aimed at providing a 1 arcmin corrected ﬁeld to MICADO, a near-infrared spectro-imager with a focus on astrometry. In this paper we review the main requirements and analysis that justify the current adaptive optics architecture and subsystem requirements. We discuss the wavefront error budget allocation focusing on the worst oﬀenders terms and on a statistical analysis of their dependence on atmospheric and sodium proﬁles. We present an updated revision of the trade-oﬀ studies on the main AO parameters that, along with considerations coming from optical and mechanical subsystems, are used to deﬁne the preliminary design of the instrument.},
	language = {en},
	booktitle = {Proceedings of the {Adaptive} {Optics} for {Extremely} {Large} {Telescopes} 6},
	author = {Busoni, Lorenzo and Agapito, Guido and Plantet, Cedric and Oberti, Sylvain and Verinaud, Christophe and Louarn, Miska Le and Esposito, Simone and Ciliegi, Paolo},
