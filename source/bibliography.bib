Medium: PDF},
	keywords = {MULTICONJUGATE ADAPTIVE OPTICS, ELT, MORFEO, CALIBRATION, MECHANICAL DESIGN, OPTICAL DESIGN, OPTOMECHANICS},
	pages = {8 pages},
}

@article{martinez_using_2023,
	title = {Using {PASSATA} for the numerical simulations of the {CaNaPy} {LGS}-{AO} monostatic, pre-compensated system},
	copyright = {CC-BY},
	url = {https://hal.science/AO4ELT7/hal-04429152},
	doi = {10.13009/AO4ELT7-2023-113},
	abstract = {This paper relates to the numerical simulations applied to CaNaPy, a monostatic LGS-AO system being now integrated at the ESA OGS 1m telescope. CaNaPy is a demonstrator of LGS-AO systems for visible wavelengths. The primary objective of CaNaPy is to create a field test facility with a novel LGS-AO architectures based onmonostatic propagation, by showcasing their feasibility and performance, thereby laying the groundwork for possible future LGS-AO instruments for visible wavelengths in the 4m, 8m and 40m class telescopes. CaNaPy offers an LGS-AO experimental TRL6 facility for verifying several breakthroughs, including a 70W CW 589nm laser with frequency chirping operated in pulsed mode, full uplink beam correction aimed at reducing the LGS{\textbackslash}'s size at the mesosphere, pyramid wavefront sensor utilising the small LGS thus gaining in sensitivity, in an AO system for best performances at visible wavelengths. A complete simulation of the monostatic CaNaPy facility has now been established in PASSATA, an IDL-based object-oriented simulation software for end-to-end numerical simulations of adaptive optics systems developed at Istituto Nazionale di Astro-Fisica (INAF). PASSATA functionalities have been upgraded to simulate the CaNaPy configuration. This modelling includes geometrical and physical optics propagation of the upward-propagated guide star laser, precise time delay modeling for the up and downlink of the laser beam, extended vertical sodium profile, and Karhunen-Loeve modal gain optimization within the control loop. The LGS-AO system simulated in CaNaPy employs a pulsed 70W laser with 33\% duty cycle, with the 589nm laser that propagates through the entire 1-m aperture of the ESA OGS telescope at Teide Observatory, using double axicon optics to prevent losses caused by the central obstruction. We will present the expected performance of this monostatic, pulsed operation approach, in which the same pupil is utilized for both transmitting and receiving the laser beam. The primary objective of CaNaPy is to verify the effectiveness of its technologies in preparation for their possible implementation in large and extremely large telescopes. To achieve this goal, we have expanded our numerical modelling efforts also to explore the feasibility of scaling CaNaPy{\textbackslash}'s system to larger apertures. This work aims at identifying performance drivers for the optimum trade-off between complexity and performance gain.},
	language = {Eng},
	publisher = {Proceedings of AO4ELT7 conference 2023 - Editors: Thierry Fusco and Benoit Neichel},
	author = {Martinez, Noelia and Agapito, Guido and Stadler, Bernadett and Bonaccini Calia, Domenico and Farley, Ollie J.D and Jenkins, David and Alaluf, David and Reyes Garcia-Talavera, Marcos and Centrone, Mauro and Puglisi, Alfio},
	year = {2023},
	note = {Artwork Size: 15 pages
Medium: PDF},
	keywords = {ADAPTIVE OPTICS, CANAPY, COMPENSATION, LASER GUIDE STAR, MONOSTATIC, PASSATA, UPLINK PRE},
	pages = {15 pages},
}

@article{plantet_spatiotemporal_2022,
	title = {Spatiotemporal statistics of the turbulent piston-removed phase and {Zernike} coefficients for two distinct beams},
	volume = {39},
	issn = {1084-7529, 1520-8532},
	url = {https://opg.optica.org/abstract.cfm?URI=josaa-39-1-17},
	doi = {10.1364/JOSAA.431520},
	abstract = {In the context of adaptive optics for astronomy, one can rely on the statistics of the turbulent phase to assess a part of the system’s performance. Temporal statistics with one source and spatial statistics with two sources are well known and widely used for classical adaptive optics systems. A more general framework, including both spatial and temporal statistics, can be useful for analysis of the existing systems and to support the design of future ones. In this paper, we propose an expression of the temporal cross power spectral densities of turbulent phases in two distinct beams, which is from two different sources to two different apertures. We consider the phase either as it is, without a piston, or as its decomposition on Zernike modes. The general formulas allow coverage of a wide variety of configurations, from single-aperture to interferometric telescopes equipped with adaptive optics, with the possibility to consider apertures of different sizes and/or sources at a finite distance. The presented approach should lead to similar results with respect to existing methods in the Fourier domain, but it is focused on temporal frequencies rather than spatial ones, which might be convenient for some aspects such as control optimization. To illustrate this framework with a simple application, we demonstrate that the wavefront residual due to the anisoplanatism error in a single-conjugated adaptive optics system is overestimated when it is computed from covariances without taking into account the temporal filtering of the adaptive optics loop. We also show this overestimation in the case of a small-baseline interferometer, for which the two beams are significantly correlated.},
	language = {en},
	number = {1},
	journal = {Journal of the Optical Society of America A},
	author = {Plantet, Cédric and Carlà, Giulia and Agapito, Guido and Busoni, Lorenzo},
	month = jan,
	year = {2022},
	pages = {17},
	file = {Versione inviata:/Users/guido/Zotero/storage/JWZL9RHQ/Plantet et al. - 2022 - Spatiotemporal statistics of the turbulent piston-removed phase and Zernike coefficients for two dis.pdf:application/pdf},
}

