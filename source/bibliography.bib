@article{gillessen_gas_2026,
	title = {The gas streamer {G1}–2–3 in the {Galactic} center},
	volume = {707},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/10.1051/0004-6361/202555808},
	doi = {10.1051/0004-6361/202555808},
	abstract = {The black hole in the Galactic center, Sgr A*, is prototypical of ultra-low-fed galactic nuclei. The discovery of a handful of gas clumps with masses on the order of a few Earth masses in its immediate vicinity provides a gas reservoir sufficient to power Sgr A*. In particular, the gas cloud G2 is of interest due to its extreme orbit, on which it passed at a pericenter distance of around 100 AU and notably lost kinetic energy during the fly-by due to interaction with the black hole accretion flow. Thirteen years prior to G2, a similar gas cloud called G1, passed Sgr A* on a similar orbit. The origin of G2 remained a topic of discussion, with models including a central (stellar) source still proposed as alternatives to pure gas clouds. Here, we report the orbit of a third gas clump moving along (nearly) the same orbital trace. Since the probability of finding three stars on such similar orbits is very low, this strongly argues against stellar-based source models. Instead, we show that the gas streamer G1–2–3 plausibly originates from the stellar wind of the massive binary star IRS 16SW. This claim is substantiated by the fact that the small differences between the three orbits – the orientations of the orbital ellipses in their common plane as a function of time – are consistent with the orbital motion of IRS 16SW.},
	journal = {Astronomy \& Astrophysics},
	author = {Gillessen, S. and Eisenhauer, F. and Cuadra, J. and Genzel, R. and Calderon, D. and Joharle, S. and Piran, T. and Ribeiro, D. C. and Russell, C. M. P. and Sadun Bordoni, M. and Burkert, A. and Bourdarot, G. and Drescher, A. and Mang, F. and Ott, T. and Agapito, G. and Agudo Berbel, A. and Baruffolo, A. and Bonaglia, M. and Black, M. and Briguglio, R. and Cao, Y. and Carbonaro, L. and Cresci, G. and Dallilar, Y. and Davies, R. and Deysenroth, M. and Di Antonio, I. and Di Cianno, A. and Di Rico, G. and Doelman, D. and Dolci, M. and Esposito, S. and Fantinel, D. and Ferruzzi, D. and Feuchtgruber, H. and Förster Schreiber, N. M. and Glauser, A. M. and Grani, P. and Hartl, M. and Henry, D. and Huber, H. and Keller, C. and Kenworthy, M. and Kravchenko, K. and Lightfoot, J. and Lunney, D. and Lutz, D. and Macintosh, M. and Mannucci, F. and Pearson, D. and Puglisi, A. and Rabien, S. and Rau, C. and Riccardi, A. and Salasnich, B. and Shimizu, T. and Snik, F. and Sturm, E. and Tacconi, L. J. and Taylor, W. and Valentini, A. and Waring, C. and Xompero, M.},
