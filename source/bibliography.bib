@inproceedings{oberti_lgs_2019,
	title = {{LGS} tomography and spot truncation: tips and tricks},
	url = {https://ao4elt6.copl.ulaval.ca/proceedings/401-gBkJ-251.pdf},
	abstract = {MAORY is the Laser Guide Star (LGS) assisted Multi Conjugated Adaptive Optics (MCAO) module of ESO’s ELT where MAORY will provide a corrected field of view of 1 arcminute to its first client instrument MICADO. In the framework of the design phase B, the dimensioning of the LGS Shack-Hartmann Wave Front Sensor (WFS) has been investigated. On an ELT scale, the LGS spot truncation is severe and may lead to a potential loss of performance due to measurement noise as well as non-linearity and truncation induced bias.},
